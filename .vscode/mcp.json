{
  "servers": {
    "trading212-demo": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "--directory",
        "/absolute/path/to/trading212-mcp-server",
        "trading212-mcp-server"
      ],
      "env": {
        "TRADING212_API_KEY": "${env:TRADING212_API_KEY}",
        "TRADING212_API_SECRET": "${env:TRADING212_API_SECRET}",
        "ENVIRONMENT": "demo"
      }
    }
  }
}
